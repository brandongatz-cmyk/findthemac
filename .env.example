# Email Configuration (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=alerts@findthemac.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=alerts@findthemac.com

# Stripe Configuration
STRIPE_SECRET_KEY=rk_live_your-restricted-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key
STRIPE_PRICE_PRO=price_your-pro-price-id
STRIPE_PRICE_ULTRA=price_your-ultra-price-id

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your-account-sid
# Option A: API Key (recommended)
TWILIO_API_KEY_SID=your-api-key-sid
TWILIO_API_KEY_SECRET=your-api-key-secret
# Option B: Auth Token (fallback)
# TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Monitor Settings
CHECK_INTERVAL_FREE_MINUTES=5
CHECK_INTERVAL_PAID_SECONDS=15
